# Base URL of the shared backend API (including /api).
# Copy to .env.local (git-ignored) and adjust.
#
# - Deployed backend:          https://<your-backend>.onrender.com/api
# - Android emulator → laptop: http://10.0.2.2:4000/api
# - Physical phone (Expo Go):  http://<your-laptop-LAN-IP>:4000/api
#
# If unset during development, the app derives the laptop's address from the
# Expo dev server automatically (http://<dev-machine-ip>:4000/api).
EXPO_PUBLIC_API_URL=
