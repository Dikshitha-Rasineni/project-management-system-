# ------------------------------------------------------------------
# Project Management System — backend environment variables
# Copy to .env and fill in. NEVER commit a real .env file.
# ------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the API listens on (Render/Railway inject PORT automatically)
PORT=4000

# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/pms?schema=public
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pms?schema=public

# Secret used to sign JWTs. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# How long a login stays valid (zeit/ms format: 15m, 12h, 7d ...)
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API (the web app).
# The mobile app is a native client and does not send an Origin header, so it
# is not affected by CORS.
CORS_ORIGIN=http://localhost:5173

# bcrypt cost factor (10–14 is reasonable; higher is slower and stronger)
BCRYPT_SALT_ROUNDS=12

# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=10

# Set to 1 when running behind a reverse proxy (Render, Railway, Fly, Nginx)
# so rate limiting sees the real client IP.
TRUST_PROXY=0

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
