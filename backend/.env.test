# Used only by `npm test`. Points at a SEPARATE database that the test suite
# wipes between tests. Not a secret — safe to commit.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pms_test?schema=public
JWT_SECRET=test-only-secret-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=4
AUTH_RATE_LIMIT_MAX=1000
LOG_LEVEL=silent
